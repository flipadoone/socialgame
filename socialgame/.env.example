# Copie para .env (copy .env.example .env) e reinicie o `npm run dev` ao alterar.

# --- Backend Spring Boot (login, cadastro e validação de sessão) ---
VITE_API_URL=http://localhost:8080

# --- Incident Manager (Angular), aberto em iframe já autenticado ---
VITE_ANGULAR_URL=http://localhost:4200

# --- Robô da sala: janela de conversa do TalkToMe (canal Widget) ---
# Em app.talktome.com.br: Canais > seu canal Widget > aba Geral > Código de integração.
# Copie SÓ o valor de data-client-key (chave pública). NUNCA use a API Key secreta aqui.
VITE_TALKTOME_WIDGET_KEY=

# --- Servidor da sala: chat, multiplayer, skins, layout e beat (`npm run dev` já o inicia) ---
VITE_ROOM_WS_URL=ws://localhost:8787
VITE_ROOM_ID=nemolandia-main-room

# ===== Variáveis do SERVIDOR da sala (lidas pelo Node, NÃO use prefixo VITE_ para segredos) =====
ROOM_BEAT_PORT=8787
# Precisa ser IGUAL ao JWT_SECRET do backend. Vazio = usa o segredo de DESENVOLVIMENTO do backend.
ROOM_JWT_SECRET=
# Origens autorizadas a abrir a conexão. Ex.: http://localhost:5173,https://seu-dominio.com
ROOM_ALLOWED_ORIGINS=
# false = permite entrar sem login (somente leitura); use só para testes locais.
ROOM_REQUIRE_AUTH=true
