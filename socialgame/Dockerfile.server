# Servidor da sala (WebSocket): chat, presença, skins, layout e beat.
FROM node:22-alpine
WORKDIR /app
# O servidor só precisa do pacote "ws"; "type: module" é exigido pelos imports ES.
RUN echo '{"name":"nemolandia-room-server","private":true,"type":"module"}' > package.json \
 && npm install --omit=dev --no-audit --no-fund ws@8
COPY server ./server
ENV ROOM_BEAT_PORT=8787 \
    ROOM_DATA_FILE=/data/room-layouts.json \
    ROOM_CHAT_FILE=/data/chat-history.json
RUN mkdir -p /data && chown node:node /data
VOLUME /data
EXPOSE 8787
USER node
CMD ["node", "server/roomServer.js"]
